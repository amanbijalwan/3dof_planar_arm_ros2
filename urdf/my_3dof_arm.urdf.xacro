<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="scara_robot">
<!-- ROBOT v2: SCARA Type 3dof -->
  <!-- Base -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry><cylinder length="0.25" radius="0.075"/></geometry>
      <material name="grey"><color rgba="0.7 0.7 0.7 1"/></material>
    </visual>
  </link>

  <!-- Joint1: Base rotation -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.275" rpy="0 0 0"/>
    <axis xyz="0 0 2"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1"/>
  </joint>
  <link name="link1">
    <visual>
      <geometry><box size="0.3 0.075 0.035"/></geometry>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <material name="blue"><color rgba="0.2 0.6 0.9 1"/></material>
    </visual>
  </link>

  <!-- Joint2: Shoulder rotation -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.25 0 0.030" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.36" upper="2.36" effort="10" velocity="1"/>
  </joint>
  <link name="link2">
    <visual>
      <geometry><box size="0.25 0.055 0.035"/></geometry>
      <origin xyz="0.125 0 0" rpy="0 0 0"/>
      <material name="red"><color rgba="0.9 0.3 0.3 1"/></material>
    </visual>
  </link>

  <!-- Joint3: Z-axis -->
  <joint name="joint3" type="prismatic">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.125 0 0.015" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.12" upper="0.08" effort="10" velocity="1"/>
  </joint>
  <link name="link3">
    <visual>
      <geometry><box size="0.02 0.03 0.25"/></geometry>
      <origin xyz="0.1 0 0" rpy="0 0 0"/>
      <material name="green"><color rgba="0.2 0.75 0.3 1"/></material>
    </visual>
    <visual>
      <origin xyz="0.1 0 -0.12" rpy="0 0 0"/>
      <geometry><sphere radius="0.020"/></geometry>
      <material name="yellow"><color rgba="0.35 0.35 0.75 1"/></material>
    </visual>
  </link>



</robot>

<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="my_3dof_arm">

  <!-- Base -->
  <link name="base_link">
    <visual>
      <geometry><cylinder length="0.1" radius="0.05"/></geometry>
      <material name="grey"><color rgba="0.7 0.7 0.7 1"/></material>
    </visual>
  </link>

  <!-- Shoulder joint -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
  </joint>
  <link name="link1">
    <visual>
      <geometry><box size="0.3 0.05 0.05"/></geometry>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <material name="blue"><color rgba="0.2 0.6 0.9 1"/></material>
    </visual>
  </link>

  <!-- Elbow joint -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.3 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
  </joint>
  <link name="link2">
    <visual>
      <geometry><box size="0.25 0.04 0.04"/></geometry>
      <origin xyz="0.125 0 0" rpy="0 0 0"/>
      <material name="red"><color rgba="0.9 0.3 0.3 1"/></material>
    </visual>
  </link>

  <!-- Wrist joint -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.25 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
  </joint>
  <link name="link3">
    <visual>
      <geometry><box size="0.2 0.03 0.03"/></geometry>
      <origin xyz="0.1 0 0" rpy="0 0 0"/>
      <material name="green"><color rgba="0.3 0.9 0.3 1"/></material>
    </visual>
  </link>

  <!-- End effector -->
  <link name="ee_link">
    <visual>
      <geometry><sphere radius="0.03"/></geometry>
      <origin xyz="0.02 0 0" rpy="0 0 0"/>
      <material name="yellow"><color rgba="0.9 0.9 0.2 1"/></material>
    </visual>
  </link>
  <joint name="ee_joint" type="fixed">
    <parent link="link3"/>
    <child link="ee_link"/>
    <origin xyz="0.2 0 0" rpy="0 0 0"/>
  </joint>

</robot>
